{
  "id": "lobsterai-model-compat",
  "name": "智码 GLM Code Model Compatibility",
  "description": "Applies explicit 智码 GLM Code-managed model runtime profiles.",
  "providers": ["lobsterai-model-compat", "zhima-coding", "lobsterai-server"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "modelProfiles": {
        "type": "object",
        "propertyNames": {
          "pattern": "^[^/\\s]+/[^\\s]+$"
        },
        "additionalProperties": {
          "type": "string",
          "enum": ["moonshot-kimi-k3"]
        }
      }
    },
    "required": ["modelProfiles"]
  }
}
